# Copy to .env and fill in. .env is gitignored.
# One key reaches Jev; the `jev` judge takes the first that is set, in this order. With none of them,
# Jev 1.13 on OpenCode Zen answers, free for a limited time (what it judges goes to OpenCode).
# TypeSafe, Jev's maker: https://typesafe.ai
TYPESAFE_API_KEY=
# Jev on OpenRouter (a key kept for the judge alone).
MU_JUDGE_OPENROUTER_API_KEY=
# Vercel AI Gateway key (vck_...): typesafe-ai/jev.
AI_GATEWAY_API_KEY=
# OpenCode Zen: the paid Jev 1.13, and OpenCode's chat models.
OPENCODE_API_KEY=
