# Copy to .env and fill in. .env is gitignored.
# One key reaches Jev; the `jev` judge takes the first that is set, in this order.
# TypeSafe, Jev's maker: https://typesafe.ai
TYPESAFE_API_KEY=
# Jev on OpenRouter (a key kept for the judge alone).
MU_JUDGE_OPENROUTER_API_KEY=
# Vercel AI Gateway key (vck_...): typesafe-ai/jev.
AI_GATEWAY_API_KEY=
# OpenCode Zen: Jev 1.13, and OpenCode's chat models. Without any key, the judge jev-opencode-free still answers.
OPENCODE_API_KEY=
