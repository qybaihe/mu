#!/usr/bin/env bash
# Manage the mu local judge sidecar (Laya on Core ML, Apple silicon only).
#
#   kyrn/bin/kyrn-judge-local setup    create the venv, install pinned deps, download the weights (~680 MB)
#   kyrn/bin/kyrn-judge-local start    start in the background if it is not already running
#   kyrn/bin/kyrn-judge-local stop
#   kyrn/bin/kyrn-judge-local status
#   kyrn/bin/kyrn-judge-local run      run in the foreground
#
# One sidecar serves every mu session on this machine. State lives in ~/.mu/local-judge
# (~/.kyrn/local-judge on a machine whose home has not been moved yet).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
HOME_DIR="$ROOT/kyrn/local-judge"
MODEL_REPO="aac6fef/laya-multilingual-coreml"
if [[ -d "$HOME/.mu" || ! -d "$HOME/.kyrn" ]]; then MU_DIR="$HOME/.mu"; else MU_DIR="$HOME/.kyrn"; fi
RUN_DIR="${MU_LOCAL_JUDGE_RUN_DIR:-${KYRN_LOCAL_JUDGE_RUN_DIR:-$MU_DIR/local-judge}}"
# A checkout keeps the venv and the weights beside server.py. The npm package (mu-agent) keeps them in mu's
# home instead: npm replaces the whole package folder on every update.
if [[ -d "$ROOT/packages/kyrn-judge" ]]; then STATE_DIR="$HOME_DIR"; else STATE_DIR="$RUN_DIR"; fi
PYTHON="$STATE_DIR/.venv/bin/python"
MODEL_DIR="${MU_LOCAL_JUDGE_MODEL:-${KYRN_LOCAL_JUDGE_MODEL:-$STATE_DIR/models/laya-multilingual-coreml}}"
PORT="${MU_LOCAL_JUDGE_PORT:-${KYRN_LOCAL_JUDGE_PORT:-47823}}"
PID_FILE="$RUN_DIR/judge.pid"
LOG_FILE="$RUN_DIR/judge.log"
URL="http://127.0.0.1:$PORT"

health() { curl -s --max-time 2 "$URL/health" 2>/dev/null || true; }

is_ready() { [[ "$(health)" == *'"status": "ok"'* ]]; }

is_up() { [[ "$(health)" == *'"status"'* ]]; }

require_setup() {
  if [[ ! -x "$PYTHON" || ! -f "$MODEL_DIR/coreml_config.json" ]]; then
    echo "The local judge is not installed. Run: mu judge setup" >&2
    exit 1
  fi
}

cmd_setup() {
  if [[ "$(uname -s)-$(uname -m)" != "Darwin-arm64" ]]; then
    echo "laya-coreml needs Apple silicon and macOS 15+." >&2
    exit 1
  fi
  command -v uv >/dev/null || { echo "uv is required: https://docs.astral.sh/uv/" >&2; exit 1; }
  mkdir -p "$STATE_DIR"
  [[ -x "$PYTHON" ]] || uv venv --python 3.12 "$STATE_DIR/.venv"
  # The official index on purpose: mirrors lag behind new releases.
  uv pip install --python "$PYTHON" --index-url https://pypi.org/simple -r "$HOME_DIR/requirements.lock.txt"
  if [[ ! -f "$MODEL_DIR/coreml_config.json" ]]; then
    "$PYTHON" - "$MODEL_REPO" "$MODEL_DIR" <<'PY'
import sys
from huggingface_hub import snapshot_download

snapshot_download(
    sys.argv[1],
    local_dir=sys.argv[2],
    allow_patterns=[
        "coreml_config.json", "rl_agent_config.json", "encoder/config.json", "tokenizer/*",
        "model.mlpackage/**", "host_weights.safetensors", "README.md", "LICENSE*", "NOTICE*",
    ],
)
PY
  fi
  "$PYTHON" - "$MODEL_DIR" <<'PY'
import json, sys
from pathlib import Path
from laya_coreml.artifacts import verify_files

directory = Path(sys.argv[1])
manifest = json.loads((directory / "coreml_config.json").read_text())
verify_files(directory, manifest["files"])
print(f"weights verified against the bundle manifest ({len(manifest['files'])} files)")
PY
}

cmd_run() {
  require_setup
  exec "$PYTHON" "$HOME_DIR/server.py" --model-dir "$MODEL_DIR" --port "$PORT" "$@"
}

cmd_start() {
  require_setup
  if is_up; then
    echo "local judge already running at $URL"
    return 0
  fi
  mkdir -p "$RUN_DIR"
  nohup "$PYTHON" "$HOME_DIR/server.py" --model-dir "$MODEL_DIR" --port "$PORT" >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"
  for _ in $(seq 1 120); do
    if is_ready; then
      echo "local judge ready at $URL (pid $(cat "$PID_FILE"), log $LOG_FILE)"
      return 0
    fi
    if ! kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "local judge exited during startup; see $LOG_FILE" >&2
      tail -5 "$LOG_FILE" >&2 || true
      return 1
    fi
    sleep 0.5
  done
  echo "local judge is still warming up; see $LOG_FILE" >&2
}

cmd_stop() {
  if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    kill "$(cat "$PID_FILE")"
    echo "stopped local judge (pid $(cat "$PID_FILE"))"
  else
    echo "local judge is not running"
  fi
  rm -f "$PID_FILE"
}

cmd_status() {
  local body
  body="$(health)"
  if [[ -n "$body" ]]; then echo "$body"; else echo "local judge is not running at $URL"; return 1; fi
}

case "${1:-status}" in
  setup) cmd_setup ;;
  run) shift; cmd_run "$@" ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  *) echo "usage: mu judge setup|start|stop|status|run" >&2; exit 2 ;;
esac
