#!/usr/bin/env bash
# Manage the mu local judge sidecar (Laya on Core ML, Apple silicon only).
#
#   kyrn/bin/kyrn-judge-local setup    create the venv, install pinned deps, download the weights (~680 MB)
#   kyrn/bin/kyrn-judge-local start    start in the background if it is not already running
#   kyrn/bin/kyrn-judge-local stop
#   kyrn/bin/kyrn-judge-local status
#   kyrn/bin/kyrn-judge-local run      run in the foreground
#
# One sidecar serves every mu session on this machine. State lives in ~/.mu/local-judge
# (~/.kyrn/local-judge on a machine whose home has not been moved yet).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
HOME_DIR="$ROOT/kyrn/local-judge"
MODEL_REPO="aac6fef/laya-multilingual-coreml"
if [[ -d "$HOME/.mu" || ! -d "$HOME/.kyrn" ]]; then MU_DIR="$HOME/.mu"; else MU_DIR="$HOME/.kyrn"; fi
RUN_DIR="${MU_LOCAL_JUDGE_RUN_DIR:-${KYRN_LOCAL_JUDGE_RUN_DIR:-$MU_DIR/local-judge}}"
# A checkout keeps the venv and the weights beside server.py. The npm package (mu-agent) keeps them in mu's
# home instead: npm replaces the whole package folder on every update.
if [[ -d "$ROOT/packages/kyrn-judge" ]]; then STATE_DIR="$HOME_DIR"; else STATE_DIR="$RUN_DIR"; fi
PYTHON="$STATE_DIR/.venv/bin/python"
MODEL_DIR="${MU_LOCAL_JUDGE_MODEL:-${KYRN_LOCAL_JUDGE_MODEL:-$STATE_DIR/models/laya-multilingual-coreml}}"
PORT="${MU_LOCAL_JUDGE_PORT:-${KYRN_LOCAL_JUDGE_PORT:-47823}}"
PID_FILE="$RUN_DIR/judge.pid"
LOG_FILE="$RUN_DIR/judge.log"
URL="http://127.0.0.1:$PORT"

health() { curl -s --max-time 2 "$URL/health" 2>/dev/null || true; }

is_ready() { [[ "$(health)" == *'"status": "ok"'* ]]; }

is_up() { [[ "$(health)" == *'"status"'* ]]; }

require_setup() {
  if [[ ! -x "$PYTHON" || ! -f "$MODEL_DIR/coreml_config.json" ]]; then
    echo "The local judge isn't installed yet. Run: mu judge setup" >&2
    exit 1
  fi
}

cmd_setup() {
  if [[ "$(uname -s)-$(uname -m)" != "Darwin-arm64" ]]; then
    echo "The local judge needs a Mac with Apple silicon and macOS 15 or later." >&2
    exit 1
  fi
  command -v uv >/dev/null || { echo "mu judge setup needs uv: https://docs.astral.sh/uv/" >&2; exit 1; }
  mkdir -p "$STATE_DIR"
  [[ -x "$PYTHON" ]] || uv venv --python 3.12 "$STATE_DIR/.venv"
  # The official index on purpose: mirrors lag behind new releases.
  uv pip install --python "$PYTHON" --index-url https://pypi.org/simple -r "$HOME_DIR/requirements.lock.txt"
  if [[ ! -f "$MODEL_DIR/coreml_config.json" ]]; then
    "$PYTHON" - "$MODEL_REPO" "$MODEL_DIR" <<'PY'
import sys
from huggingface_hub import snapshot_download

snapshot_download(
    sys.argv[1],
    local_dir=sys.argv[2],
    allow_patterns=[
        "coreml_config.json", "rl_agent_config.json", "encoder/config.json", "tokenizer/*",
        "model.mlpackage/**", "host_weights.safetensors", "README.md", "LICENSE*", "NOTICE*",
    ],
)
PY
  fi
  "$PYTHON" - "$MODEL_DIR" <<'PY'
import json, sys
from pathlib import Path
from laya_coreml.artifacts import verify_files

directory = Path(sys.argv[1])
manifest = json.loads((directory / "coreml_config.json").read_text())
verify_files(directory, manifest["files"])
print(f"Weights checked against the bundle's manifest ({len(manifest['files'])} files).")
PY
}

cmd_run() {
  require_setup
  exec "$PYTHON" "$HOME_DIR/server.py" --model-dir "$MODEL_DIR" --port "$PORT" "$@"
}

cmd_start() {
  require_setup
  if is_up; then
    echo "The local judge is already running at $URL."
    return 0
  fi
  mkdir -p "$RUN_DIR"
  nohup "$PYTHON" "$HOME_DIR/server.py" --model-dir "$MODEL_DIR" --port "$PORT" >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"
  for _ in $(seq 1 120); do
    if is_ready; then
      echo "The local judge is ready at $URL (pid $(cat "$PID_FILE"), log $LOG_FILE)."
      return 0
    fi
    if ! kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "The local judge stopped while starting; see $LOG_FILE" >&2
      tail -5 "$LOG_FILE" >&2 || true
      return 1
    fi
    sleep 0.5
  done
  echo "The local judge is still warming up; see $LOG_FILE" >&2
}

cmd_stop() {
  if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    kill "$(cat "$PID_FILE")"
    echo "Stopped the local judge (pid $(cat "$PID_FILE"))."
  else
    echo "The local judge isn't running."
  fi
  rm -f "$PID_FILE"
}

cmd_status() {
  local body
  body="$(health)"
  if [[ -z "$body" ]]; then echo "The local judge isn't running at $URL."; return 1; fi
  # --json: the server's own answer, for scripts.
  if [[ "${1:-}" == "--json" ]]; then echo "$body"; return 0; fi
  URL="$URL" node -e '
    let text = "";
    process.stdin.on("data", (chunk) => (text += chunk)).on("end", () => {
      let health;
      try { health = JSON.parse(text); } catch { console.log(text.trim()); return; }
      const up = Math.round((health.uptimeSeconds ?? 0) / 60);
      const uptime = up < 60 ? `${up} min` : `${Math.floor(up / 60)} h ${up % 60} min`;
      const state = health.status === "ok" ? "running" : `starting (${health.status})`;
      const model = String(health.model ?? "").split("/").pop();
      console.log(`The local judge is ${state} at ${process.env.URL}: ${model} on ${health.computeUnits}, pid ${health.pid}, up ${uptime}, ${health.requests} requests.`);
    });' <<<"$body"
}

usage() {
  cat <<'USAGE'
mu judge: the local judge, Laya, on Core ML (macOS on Apple silicon).

  mu judge setup           install it: a Python environment and the weights (about 680 MB)
  mu judge start           start it in the background, unless it's already running
  mu judge stop            stop it
  mu judge status [--json] whether it's running, and what it serves
  mu judge run             run it in the foreground

One local judge serves every mu session on this machine. To have mu ask it, add "laya" to "tiers" in
mu.json, or start mu with MU_JUDGE=laya.
USAGE
}

case "${1:-status}" in
  setup) cmd_setup ;;
  run) shift; cmd_run "$@" ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) shift; cmd_status "$@" ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
